# HealthStream v2 - example environment file. Copy to .env and fill in
# your own values. .env is gitignored and must never be committed.
# Local Docker database passwords (local containers only):
POSTGRES_PASSWORD=your_postgres_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_PASSWORD=your_mysql_password_here
DEBEZIUM_PASSWORD=your_debezium_password_here
# Cloud / AI variables (only needed for the full demo):
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=
OPENAI_API_KEY=
